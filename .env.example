# Copy this file to .env in the repository where you run btm.
# Never commit real API keys.

# Built-in local heuristic, no key needed:
BTM_AI_PROVIDER=heuristic

# Gemini:
# BTM_AI_PROVIDER=gemini
# GEMINI_API_KEY=paste-your-gemini-api-key-here
# BTM_AI_MODEL=gemini-2.5-flash

# OpenAI:
# BTM_AI_PROVIDER=openai
# OPENAI_API_KEY=paste-your-openai-api-key-here
# BTM_AI_MODEL=gpt-4o-mini

# OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://your-compatible-endpoint.example/v1

# Ollama local:
# BTM_AI_PROVIDER=ollama
# BTM_AI_MODEL=llama3
